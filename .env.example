# Fixora — local environment for the Live AI Acceptance Run
#
# Copy this file to `.env` (in the repo root) and paste your key below. The real `.env` is
# git-ignored, so your key is never committed. Nothing here is read by the shipped desktop app —
# the app stores its provider key in the OS-encrypted keystore. These variables are ONLY for the
# offline acceptance/benchmark harnesses.

# REQUIRED for the AI leg. Your OpenRouter API key (https://openrouter.ai/keys).
# Without it, the acceptance run still executes the deterministic leg and marks the AI leg DEFERRED.
FIXORA_BENCH_OPENROUTER_KEY=

# OPTIONAL. Pin a specific model id (e.g. a free code model). If unset, the harness auto-selects a
# default free code-capable model from the live OpenRouter catalogue.
FIXORA_BENCH_MODEL=
