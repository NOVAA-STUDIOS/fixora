{
  "name": "@fixora/core-analysis",
  "version": "0.1.0",
  "description": "The deterministic analysis engine — the moat (ADR-002), zero AI. Pure TS: tree-sitter + the workspace's own tooling in, a unified Finding model out. No Electron, no React (TDD §2).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@fixora/shared-types": "workspace:*",
    "tree-sitter-wasms": "0.1.12",
    "web-tree-sitter": "0.25.10",
    "eslint": "10.7.0"
  },
  "devDependencies": {
    "@fixora/eslint-config": "workspace:*",
    "@fixora/tsconfig": "workspace:*",
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
