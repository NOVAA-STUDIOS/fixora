{
  "name": "fixora-vscode",
  "displayName": "Fixora — AI Code Repair",
  "description": "AI-powered code analysis, repair & PR readiness scoring. Works standalone with your own API key.",
  "version": "0.2.0",
  "private": true,
  "publisher": "novaa-studios",
  "repository": { "type": "git", "url": "https://github.com/NOVAA-STUDIOS/fixora" },
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#000000", "theme": "dark" },
  "categories": ["Linters", "Programming Languages", "Machine Learning", "Other"],
  "keywords": ["ai", "code-repair", "analysis", "linting", "openai", "anthropic", "gemini", "code-quality", "pr-readiness", "fixora"],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fixora.analyze",
        "title": "Fixora: Analyze Current File"
      },
      {
        "command": "fixora.repair",
        "title": "Fixora: Repair Selected Issue"
      },
      {
        "command": "fixora.explain",
        "title": "Fixora: Explain Issue"
      },
      {
        "command": "fixora.openApp",
        "title": "Fixora: Open Fixora App"
      },
      {
        "command": "fixora.setup",
        "title": "Fixora: Setup API Key"
      }
    ],
    "configuration": {
      "title": "Fixora",
      "properties": {
        "fixora.exePath": {
          "type": "string",
          "default": "Fixora.exe",
          "description": "Path to the Fixora executable."
        },
        "fixora.mcpPort": {
          "type": ["number", "null"],
          "default": null,
          "description": "MCP server port. Leave unset to auto-select."
        },
        "fixora.autoAnalyze": {
          "type": "boolean",
          "default": false,
          "description": "Automatically analyze files on save."
        },
        "fixora.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for standalone analysis (used when the Fixora desktop app is not running)."
        },
        "fixora.aiProvider": {
          "type": "string",
          "enum": ["openai", "anthropic", "gemini", "openrouter"],
          "default": "openrouter",
          "description": "AI provider for standalone analysis."
        },
        "fixora.model": {
          "type": "string",
          "default": "google/gemini-flash-1.5",
          "description": "Model id for standalone analysis."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "devDependencies": {
    "@fixora/tsconfig": "workspace:*",
    "@types/node": "26.1.1",
    "@types/vscode": "^1.85.0",
    "typescript": "6.0.3"
  }
}
