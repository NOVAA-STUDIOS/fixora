{
  "name": "@fixora/tokens",
  "version": "0.1.0",
  "description": "Fixora design tokens. Authored once, consumed by the desktop app and the website (ADR-019).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --max-warnings 0",
    "test": "vitest run",
    "gate:contrast": "tsx scripts/check-contrast.ts"
  },
  "devDependencies": {
    "@fixora/eslint-config": "workspace:*",
    "@fixora/tsconfig": "workspace:*",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
