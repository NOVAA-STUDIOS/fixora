node_modules/
dist/
out/
build/
# ...except the packaging build resources, which are inputs rather than outputs. The icon is
# generated by `pnpm --filter @fixora/desktop icon`, but it is tracked so a release can be built on a
# machine where that rasterization step fails rather than silently falling back to Electron's default.
!apps/desktop/build/
!apps/desktop/build/**
.turbo/
coverage/
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
electronegativity-report.sarif
*.tsbuildinfo

# electron-builder packaging output
apps/desktop/release/

# Vendored third-party binaries. Acquired at BUILD time by scripts/vendor-ruff.mjs with its SHA256
# verified against a checksum committed in that script — the script and the pin are the source of
# truth, not an 11 MB blob in git history. PROVENANCE.json is written beside the binary so a built
# tree can be audited without re-downloading.
packages/core-analysis/vendor/

# Python bytecode from the validation harness compile step (should never be written into the corpus)
__pycache__/
*.pyc

# Ad-hoc scratch output from local debugging sessions
*.dev-out.txt
.suite-out.txt
.validate-out.txt
"FIXORA - Shortcut.lnk"
