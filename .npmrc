# Strict, non-hoisted node_modules. A phantom dependency is how `packages/core-*` would
# silently resolve `electron` and quietly break the boundary rule that ADR-005 and ADR-020
# depend on. Do not turn this off to make a native module build; fix the native module.
node-linker=isolated
hoist=false
strict-peer-dependencies=false
auto-install-peers=true
