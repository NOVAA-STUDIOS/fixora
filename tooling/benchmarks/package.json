{
  "name": "@fixora/benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "M6 analyzer accuracy: the golden dataset, the benchmark runner, and the accuracy report. Not shipped; still type-checked, linted and run in CI.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "bench": "tsx src/cli.ts",
    "bench:check": "tsx src/cli.ts --check",
    "capture": "tsx src/capture.ts"
  },
  "dependencies": {
    "@fixora/core-analysis": "workspace:*",
    "@fixora/shared-types": "workspace:*",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@fixora/eslint-config": "workspace:*",
    "@fixora/tsconfig": "workspace:*",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
